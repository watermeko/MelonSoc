mainmenu "MelonSoc Configuration"

choice
	prompt "DDR application"
	default DDR_APP_RTOS

config DDR_APP_RTOS
	bool "FreeRTOS test application"

config DDR_APP_LINUX
	bool "OpenSBI + Linux + BusyBox"

endchoice

menu "Test Commands"

config APP_TEST_M
	bool "Enable test-m (M extension: multiply/divide)"
	default y

config APP_TEST_CSR
	bool "Enable test-csr (CSR read/write and ECALL trap)"
	default y

config APP_TEST_IRQ
	bool "Enable test-irq (timer peripheral interrupt)"
	default y

config APP_TEST_MSIP
	bool "Enable test-msip (machine software interrupt)"
	default y

config APP_TEST_MTIME
	bool "Enable test-mtime (machine timer interrupt)"
	default y

config APP_TEST_SHIFT
	bool "Enable test-shift (SRA/SRAI and uint16 CRC)"
	default y

config APP_TEST_A
	bool "Enable test-a (RISC-V A extension LR/SC/AMO)"
	default y

endmenu
